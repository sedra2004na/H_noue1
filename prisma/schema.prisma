// Prisma Schema for Hospital Management System (Care & Al-Rahma Hospital)
// Enforces strict Role-Based Access Control (RBAC) and Medical Data Security

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Strict System Roles Enum
enum Role {
  ADMIN         // مدير النظام - صلاحيات كاملة وإنشاء حسابات الكادر
  DOCTOR        // طبيب معالج - كشوفات، وصفات، تحاليل، ملفات المرضى
  RECEPTIONIST  // موظف استقبال - حجز مواعيد، تسكين، تدقيق وتوثيق ملفات المرضى
  PATIENT       // مريض مراجع - حساب ذاتي مقيد لحجز المواعيد واستعراض السجل الشخصي
}

// 2. User & System Credentials Model
model User {
  id              String       @id @default(uuid())
  email           String       @unique
  passwordHash    String       @map("password_hash")
  salt            String?
  fullName        String       @map("full_name")
  role            Role         @default(PATIENT)
  phone           String?
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  // Relations
  doctorProfile   Doctor?
  patientProfile  Patient?
  auditLogs       AuditLog[]

  @@map("users")
}

// 3. Patient Official Medical Record Model
model Patient {
  id                    String        @id @default(uuid())
  userId                String?       @unique @map("user_id")
  fileNumber            String        @unique @map("file_number") // رقم الملف الطبي الرسمي (MRN)
  nationalId            String?       @map("national_id")         // رقم الهوية الوطنية / جواز السفر
  fullName              String        @map("full_name")
  age                   Int
  gender                String        // ذكر / أنثى
  bloodType             String?       @map("blood_type")
  phone                 String
  address               String?
  emergencyContact      String?       @map("emergency_contact")
  insuranceProvider     String?       @map("insurance_provider")
  insuranceNumber       String?       @map("insurance_number")
  medicalHistory        Json?         @map("medical_history")
  activeAllergies       Json?         @map("active_allergies")
  vitals                Json?
  
  // Security & Reception Verification Status
  isVerifiedByReception Boolean       @default(false) @map("is_verified_by_reception") // تدقيق الاستقبال
  verifiedBy            String?       @map("verified_by")                              // اسم موظف الاستقبال
  verifiedAt            DateTime?     @map("verified_at")                              // تاريخ التوثيق الرسمي
  verificationStatus    String        @default("بانتظار التحقق والمطابقة بالاستقبال")  @map("verification_status")

  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  // Relations
  user                  User?         @relation(fields: [userId], references: [id])
  appointments          Appointment[]
  invoices              Invoice[]
  prescriptions         Prescription[]
  labResults            LabResult[]

  @@map("patients")
}

// 4. Clinical Doctor Model (Provisioned Exclusively by Admin)
model Doctor {
  id              String        @id @default(uuid())
  userId          String?       @unique @map("user_id")
  name            String
  specialty       String
  department      String
  experienceYears Int           @default(5) @map("experience_years")
  consultingFee   Decimal       @default(25000) @map("consulting_fee")
  phone           String?
  roomNumber      String?       @map("room_number")
  shift           String        @default("صباحي") // صباحي, مسائي, ليلي
  status          String        @default("active")  // active, on_leave, busy, off_duty
  rating          Decimal       @default(5.0)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  // Relations
  user            User?         @relation(fields: [userId], references: [id])
  appointments    Appointment[]
  prescriptions   Prescription[]
  labResults      LabResult[]

  @@map("doctors")
}

// 5. Clinical Appointments
model Appointment {
  id          String    @id @default(uuid())
  patientId   String    @map("patient_id")
  doctorId    String    @map("doctor_id")
  date        String    // YYYY-MM-DD
  time        String    // HH:MM
  type        String    @default("كشف عيادة خارجية")
  status      String    @default("مؤكد") // مؤكد, معلق, مكتمل, ملغى
  fee         Decimal   @default(25000)
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")

  patient     Patient   @relation(fields: [patientId], references: [id])
  doctor      Doctor    @relation(fields: [doctorId], references: [id])

  @@map("appointments")
}

// 6. Billing & Invoices
model Invoice {
  id               String    @id @default(uuid())
  invoiceNumber    String    @unique @map("invoice_number")
  patientId        String    @map("patient_id")
  date             String
  subtotal         Decimal
  tax              Decimal   @default(0)
  insuranceCovered Decimal   @default(0) @map("insurance_covered")
  netAmount        Decimal   @map("net_amount")
  status           String    @default("معلق") // مدفوع, معلق, جزئي, ملغى
  claimStatus      String?   @map("claim_status")
  paymentMethod    String?   @map("payment_method")
  createdAt        DateTime  @default(now()) @map("created_at")

  patient          Patient   @relation(fields: [patientId], references: [id])

  @@map("invoices")
}

// 7. Electronic Prescriptions
model Prescription {
  id           String    @id @default(uuid())
  patientId    String    @map("patient_id")
  doctorId     String    @map("doctor_id")
  date         String
  diagnosis    String
  medicines    Json
  instructions String?   @map("instructions")
  status       String    @default("نشطة")
  createdAt    DateTime  @default(now()) @map("created_at")

  patient      Patient   @relation(fields: [patientId], references: [id])
  doctor       Doctor    @relation(fields: [doctorId], references: [id])

  @@map("prescriptions")
}

// 8. Laboratory Results
model LabResult {
  id           String    @id @default(uuid())
  patientId    String    @map("patient_id")
  doctorId     String    @map("doctor_id")
  testName     String    @map("test_name")
  testDate     String    @map("test_date")
  issuedDate   String?   @map("issued_date")
  status       String    @default("طبيعي") // طبيعي, مرتفع, منخفض, حرج
  resultValue  String    @map("result_value")
  normalRange  String    @map("normal_range")
  unit         String
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")

  patient      Patient   @relation(fields: [patientId], references: [id])
  doctor       Doctor    @relation(fields: [doctorId], references: [id])

  @@map("lab_results")
}

// 9. Pharmacy & Warehouse Inventory
model InventoryItem {
  id            String    @id @default(uuid())
  itemName      String    @map("item_name")
  category      String
  quantity      Int
  minStockAlert Int       @default(20) @map("min_stock_alert")
  price         Decimal
  batchNumber   String?   @map("batch_number")
  expiryDate    String    @map("expiry_date")
  unit          String
  status        String    @default("متوفر")
  manufacturer  String?
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("inventory_items")
}

// 10. Audit Log & Security Traceability (HIPAA & ISO-27001 Standard)
model AuditLog {
  id             String    @id @default(uuid())
  userId         String?   @map("user_id")
  userName       String    @map("user_name")
  userRole       Role      @map("user_role")
  action         String    // LOGIN, VIEW_RECORD, IDOR_BLOCKED, STAFF_ACCOUNT_PROVISIONED, PATIENT_VERIFIED
  targetResource String    @map("target_resource")
  details        String
  status         String    // SUCCESS, BLOCKED_ALERT, WARNING
  ipAddress      String?   @map("ip_address")
  timestamp      DateTime  @default(now())

  user           User?     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
