// ============================================================================
// Prisma Schema: Full-Stack Hospital Management System (مشفى الرحمة التخصصي)
// Standardized Database Architecture with UUIDs, Relations, Indexes, and Audit Logging
// ============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// 1. ENUMS (أنواع الحالات والأدوار القياسية)
// ============================================================================

enum Role {
  ADMIN
  DOCTOR
  STAFF
  PATIENT
}

enum Gender {
  MALE
  FEMALE
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  RESERVED
}

enum InvoiceStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  CANCELLED
}

// ============================================================================
// 2. USER AUTHENTICATION & ACCESS CONTROL (المستخدمون والأدوار)
// ============================================================================

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  password     String    @map("password_hash") // مشفر بـ bcrypt
  role         Role      @default(PATIENT)
  fullName     String    @map("full_name")
  phone        String?
  refreshToken String?   @map("refresh_token")
  isActive     Boolean   @default(true) @map("is_active")

  // Soft Delete (الحذف الناعم لحفظ السجلات القانونية)
  isDeleted    Boolean   @default(false) @map("is_deleted")
  deletedAt    DateTime? @map("deleted_at")

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // العلاقات (Relations)
  patientProfile Patient?
  doctorProfile  Doctor?
  auditLogs      AuditLog[]
  notifications  Notification[]

  @@index([email])
  @@index([role])
  @@map("users")
}

// ============================================================================
// 3. DOCTORS & SCHEDULES (الأطباء وجداول الدوام)
// ============================================================================

model Doctor {
  id              String           @id @default(uuid())
  userId          String           @unique @map("user_id")
  name            String
  specialization  String
  department      String           @default("الطب العام")
  licenseNumber   String?          @unique @map("license_number")
  experienceYears Int              @default(5) @map("experience_years")
  consultingFee   Decimal          @default(25000) @map("consulting_fee") @db.Decimal(10, 2)
  phone           String?
  roomNumber      String?          @map("room_number")
  isActive        Boolean          @default(true) @map("is_active")

  isDeleted       Boolean          @default(false) @map("is_deleted")
  deletedAt       DateTime?        @map("deleted_at")

  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  // العلاقات (Relations)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedules       DoctorSchedule[]
  appointments    Appointment[]
  labResults      LabResult[]

  @@index([specialization])
  @@index([department])
  @@map("doctors")
}

model DoctorSchedule {
  id          String   @id @default(uuid())
  doctorId    String   @map("doctor_id")
  dayOfWeek   String   @map("day_of_week") // مثال: السبت، الأحد...
  startTime   String   @map("start_time")  // HH:MM (مثال: 08:30)
  endTime     String   @map("end_time")    // HH:MM (مثال: 15:30)
  isAvailable Boolean  @default(true) @map("is_available")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // العلاقات
  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@index([dayOfWeek])
  @@map("doctor_schedules")
}

// ============================================================================
// 4. PATIENTS (المرضى والملفات الطبية)
// ============================================================================

model Patient {
  id               String          @id @default(uuid())
  userId           String?         @unique @map("user_id")
  fileNumber       String          @unique @map("file_number") // رقم الملف الطبي الرسمي (MRN)
  nationalId       String?         @unique @map("national_id") // الرقم الوطني
  fullName         String          @map("full_name")
  dateOfBirth      DateTime?       @map("date_of_birth")
  age              Int
  gender           Gender          @default(MALE)
  bloodType        String?         @map("blood_type")
  phone            String
  address          String?
  emergencyContact String?         @map("emergency_contact")
  medicalHistory   Json?           @map("medical_history")     // السجل المرضي المزمن
  activeAllergies  Json?           @map("active_allergies")    // الحساسيات الدوائية والغذائية

  isDeleted        Boolean         @default(false) @map("is_deleted")
  deletedAt        DateTime?       @map("deleted_at")

  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  // العلاقات (Relations)
  user             User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments     Appointment[]
  labResults       LabResult[]
  bedAssignments   BedAssignment[]
  invoices         Invoice[]

  @@index([fileNumber])
  @@index([nationalId])
  @@index([phone])
  @@map("patients")
}

// ============================================================================
// 5. APPOINTMENTS (المواعيد الطبية والعيادات)
// ============================================================================

model Appointment {
  id        String            @id @default(uuid())
  patientId String            @map("patient_id")
  doctorId  String            @map("doctor_id")
  dateTime  DateTime          @map("date_time") // توقيت الموعد الدقيق لمنع التعارض
  type      String            @default("كشف سريري")
  status    AppointmentStatus @default(CONFIRMED)
  notes     String?
  fee       Decimal?          @db.Decimal(10, 2)

  isDeleted Boolean           @default(false) @map("is_deleted")
  deletedAt DateTime?         @map("deleted_at")

  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  // العلاقات
  patient   Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor    Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([doctorId])
  @@index([dateTime])
  @@index([status])
  @@map("appointments")
}

// ============================================================================
// 6. LABORATORY & HISTORICAL POINTS (المختبر والقراءات التاريخية)
// ============================================================================

model LabResult {
  id               String               @id @default(uuid())
  patientId        String               @map("patient_id")
  doctorId         String?              @map("doctor_id")
  testName         String               @map("test_name")     // مثال: سكر الدم، الكرياتينين
  resultValue      String               @map("result_value")  // النتيجة الحالية
  normalRange      String               @map("normal_range")  // المجال الطبيعي (مثل 70-110 mg/dL)
  unit             String?                                    // الوحدة: mg/dL, mmol/L
  isAbnormal       Boolean              @default(false) @map("is_abnormal")
  performedAt      DateTime             @default(now()) @map("performed_at")

  isDeleted        Boolean              @default(false) @map("is_deleted")
  deletedAt        DateTime?            @map("deleted_at")

  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  // العلاقات
  patient          Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor           Doctor?              @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  historicalPoints LabHistoricalPoint[]

  @@index([patientId])
  @@index([testName])
  @@index([isAbnormal])
  @@map("lab_results")
}

model LabHistoricalPoint {
  id          String    @id @default(uuid())
  labResultId String    @map("lab_result_id")
  recordedAt  DateTime  @default(now()) @map("recorded_at") // تاريخ القياس
  value       Decimal   @db.Decimal(10, 2)                  // القيمة الرقمية للرسم البياني
  notes       String?                                       // ملاحظات الطبيب/المخبري

  createdAt   DateTime  @default(now()) @map("created_at")

  // العلاقات
  labResult   LabResult @relation(fields: [labResultId], references: [id], onDelete: Cascade)

  @@index([labResultId])
  @@index([recordedAt])
  @@map("lab_historical_points")
}

// ============================================================================
// 7. INVENTORY & PHARMACY (المستودع الصيدلاني والأدوية)
// ============================================================================

model InventoryItem {
  id            String    @id @default(uuid())
  itemName      String    @map("item_name")
  category      String    // أدوية، مستلزمات جراحية، محاليل وريدية
  quantity      Int
  minStockAlert Int       @default(10) @map("min_stock_alert") // حد التنبيه عند النقص
  unitPrice     Decimal   @map("unit_price") @db.Decimal(10, 2)
  expiryDate    DateTime? @map("expiry_date")
  batchNumber   String?   @map("batch_number")
  unit          String    @default("علبة")

  isDeleted     Boolean   @default(false) @map("is_deleted")
  deletedAt     DateTime? @map("deleted_at")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([itemName])
  @@index([category])
  @@index([expiryDate])
  @@map("inventory_items")
}

// ============================================================================
// 8. BEDS & WARD ASSIGNMENTS (الأجنحة والأسِرّة والتسكين)
// ============================================================================

model Bed {
  id             String          @id @default(uuid())
  wardName       String          @map("ward_name")   // اسم الجناح: العناية القلبية، الجراحة
  bedNumber      String          @unique @map("bed_number") // رقم السرير: ICU-101
  roomNumber     String          @map("room_number")
  status         BedStatus       @default(AVAILABLE)
  oxygenEquipped Boolean         @default(true) @map("oxygen_equipped")
  notes          String?

  isDeleted      Boolean         @default(false) @map("is_deleted")
  deletedAt      DateTime?       @map("deleted_at")

  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  // العلاقات
  assignments    BedAssignment[]

  @@index([wardName])
  @@index([status])
  @@map("beds")
}

model BedAssignment {
  id            String    @id @default(uuid())
  bedId         String    @map("bed_id")
  patientId     String    @map("patient_id")
  admissionDate DateTime  @default(now()) @map("admission_date")
  dischargeDate DateTime? @map("discharge_date")
  diagnosis     String?   // تشخيص الدخول
  notes         String?

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // العلاقات
  bed           Bed       @relation(fields: [bedId], references: [id], onDelete: Cascade)
  patient       Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([bedId])
  @@index([patientId])
  @@index([dischargeDate])
  @@map("bed_assignments")
}

// ============================================================================
// 9. INVOICES & BILLING (الفواتير والمدفوعات)
// ============================================================================

model Invoice {
  id               String        @id @default(uuid())
  invoiceNumber    String        @unique @map("invoice_number")
  patientId        String        @map("patient_id")
  amount           Decimal       @db.Decimal(12, 2)
  tax              Decimal       @default(0) @db.Decimal(10, 2)
  insuranceCovered Decimal       @default(0) @map("insurance_covered") @db.Decimal(12, 2)
  netAmount        Decimal       @map("net_amount") @db.Decimal(12, 2)
  status           InvoiceStatus @default(PENDING)
  paymentMethod    String?       @map("payment_method") // كاش، تأمين، شام كاش

  isDeleted        Boolean       @default(false) @map("is_deleted")
  deletedAt        DateTime?     @map("deleted_at")

  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  // العلاقات
  patient          Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([invoiceNumber])
  @@index([patientId])
  @@index([status])
  @@map("invoices")
}

// ============================================================================
// 10. NOTIFICATIONS (الإشعارات والتنبيهات الحية)
// ============================================================================

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  message   String
  type      String   @default("info") // danger, warning, info
  isRead    Boolean  @default(false) @map("is_read")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // العلاقات
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

// ============================================================================
// 11. AUDIT LOG (سجل التدقيق الأمني - عدم الإنكار HIPAA & Non-Repudiation)
// ============================================================================

model AuditLog {
  id             String   @id @default(uuid())
  userId         String?  @map("user_id")
  userName       String   @map("user_name")
  userRole       Role     @map("user_role")
  action         String   // LOGIN, VIEW_RECORD, IDOR_BLOCKED, UPDATE_BED
  targetResource String   @map("target_resource")
  details        String
  status         String   // SUCCESS, BLOCKED_ALERT, WARNING
  ipAddress      String?  @map("ip_address")
  timestamp      DateTime @default(now())

  // العلاقات
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([timestamp])
  @@map("audit_logs")
}
